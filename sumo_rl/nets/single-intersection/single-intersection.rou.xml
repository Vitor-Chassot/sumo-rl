<routes>
    <route id="route_ns" edges="n_t t_s"/>
    <route id="route_we" edges="w_t t_e"/>
    
    <!-- Fluxo de veículos original -->
    <flow id="flow_ns" route="route_ns" begin="0" end="100000" probability="0.2" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_we" route="route_we" begin="0" end="100000" probability="0.5" departSpeed="max" departPos="base" departLane="best"/>

    <!-- Fluxo de pedestres atravessando Norte -> Sul -->
    <personFlow id="p_ns" begin="0" end="100000" personsPerHour="300">
        <walk edges="n_t t_s"/>
    </personFlow>

    <!-- Fluxo de pedestres atravessando Oeste -> Leste -->
    <personFlow id="p_we" begin="0" end="100000" personsPerHour="300">
        <walk edges="w_t t_e"/>
    </personFlow>
</routes>

